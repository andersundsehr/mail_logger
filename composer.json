{
  "name": "pluswerk/mail-logger",
  "description": "Mail Logger by anders und sehr GmbH",
  "license": "GPL-2.0-or-later",
  "type": "typo3-cms-extension",
  "homepage": "https://www.andersundsehr.com/",
  "support": {
    "issues": "https://github.com/andersundsehr/mail_logger/issues",
    "source": "https://github.com/andersundsehr/mail_logger",
    "docs": "https://github.com/andersundsehr/mail_logger/blob/master/README.md"
  },
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
    "composer-runtime-api": "^2",
    "typo3/cms-core": "^13.4.0",
    "typo3/cms-extbase": "^13.4.0"
  },
  "require-dev": {
    "ext-json": "*",
    "andersundsehr/no-ci": "^1.1",
    "helhum/typo3-console": "^8.3.1",
    "pluswerk/grumphp-config": "^10.2.9",
    "saschaegerer/phpstan-typo3": "^2.2.0",
    "spatie/phpunit-snapshot-assertions": "^5.4.0",
    "ssch/typo3-rector": "^3.14.4",
    "typo3/testing-framework": "^9.6.1"
  },
  "replace": {
    "pluswerk/mail_logger": "self.version",
    "typo3-ter/mail-logger": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Pluswerk\\MailLogger\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pluswerk\\MailLogger\\Tests\\": "Tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "andersundsehr/no-ci": true,
      "cweagans/composer-patches": true,
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true,
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    },
    "sort-packages": true
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "mail_logger"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "@composer bump --dev-only",
      "@composer normalize"
    ],
    "test": "vendor/bin/phpunit --color=always --no-coverage",
    "test:update": "vendor/bin/phpunit --color=always -d --update-snapshots"
  },
  "scripts-descriptions": {
    "test": "run tests for this extension"
  }
}
